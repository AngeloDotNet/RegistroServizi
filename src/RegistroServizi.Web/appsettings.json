{
    "Kestrel": {
        "Limits": {
            "MaxRequestBodySize": 5242880
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "SqlServerConnection": "Data Source=[HOSTNAME];Initial Catalog=RegistroServizi;User ID=[USERNAME];Password=[PASSWORD];Encrypt=False"
    },
    "Database": {
        "ApplyMigrationsOnStartup": false
    },
    "Identity": {
        "RequireConfirmedAccount": false,
        "AllowedForNewUsers": true,
        "MaxFailedAccessAttempts": 5,
        "DefaultLockoutTimeSpan": "00:15:00",
        "Password": {
            "RequiredLength": 10
        }
    }
}