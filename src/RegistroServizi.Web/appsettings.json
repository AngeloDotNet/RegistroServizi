{
    "Kestrel": {
        "Limits": {
            "MaxRequestBodySize": 5242880
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=[HOSTNAME];Initial Catalog=RegistroServizi;User ID=[USERNAME];Password=[PASSWORD];Encrypt=False"
    },
    "Database": {
        "ApplyMigrationsOnStartup": false
    }
}