@using System.Threading
@inject IOptionsMonitor<ApplicazioneOptions> ApplicazioneOptions
@inject IStringLocalizer<NavigationResource> Localizer

@page "/"

<TextPageTitle Title="Registro Servizi" SubTitle="@Localizer["Dashboard"]" />

<p>TimeZone: @(timeZone?.Id ?? "Non disponibile")</p>
<h6>Sono le ore @DateTime.Now.ToString("HH:mm") - Orario UTC: @DateTime.UtcNow.ToString("HH:mm")</h6>

@code {
    private TimeZoneInfo? timeZone;
    private static TimeZoneInfo? cachedTimeZone;
    private static readonly SemaphoreSlim cacheLock = new SemaphoreSlim(1, 1);

    protected override async Task OnInitializedAsync()
    {
        timeZone = await GetTimeZoneAsync();
    }

    public async Task<TimeZoneInfo> GetTimeZoneAsync(CancellationToken cancellationToken = default)
    {
        if (cachedTimeZone is not null)
        {
            return cachedTimeZone;
        }

        await cacheLock.WaitAsync(cancellationToken).ConfigureAwait(false);

        try
        {
            if (cachedTimeZone is not null)
            {
                return cachedTimeZone;
            }

            // Allow an environment override for runtime configurability; fallback to the default id.
            //string tzId = System.Environment.GetEnvironmentVariable("APP_TIMEZONE") ?? "Europe/Rome";
            string tzId = ApplicazioneOptions.CurrentValue.TimeZone ?? "Europe/Rome";
            TimeZoneInfo result;

            try
            {
                result = TimeZoneInfo.FindSystemTimeZoneById(tzId);

                if (result is null)
                {
                    result = TimeZoneInfo.Utc;
                }
            }
            catch (TimeZoneNotFoundException)
            {
                result = TimeZoneInfo.Utc;
            }
            catch (InvalidTimeZoneException)
            {
                result = TimeZoneInfo.Utc;
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception)
            {
                result = TimeZoneInfo.Utc;
            }

            cachedTimeZone = result;
            return cachedTimeZone;
        }
        finally
        {
            cacheLock.Release();
        }
    }
}