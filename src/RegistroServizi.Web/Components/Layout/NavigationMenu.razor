@implements IDisposable

<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Class="px-4 py-2 mud-text-secondary">
        Data: @CurrentDateTime.ToString("dd/MM/yyyy HH:mm:ss")
    </MudText>
    <MudNavLink Href="/nuova-missione" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MedicalServices">Nuova Missione</MudNavLink>
    <MudNavLink Href="/elenco-personale" Icon="@Icons.Material.Filled.People">Elenco Personale</MudNavLink>
    <MudNavLink Href="/elenco-servizi" Icon="@Icons.Material.Filled.Bookmarks">Elenco Servizi</MudNavLink>
    <MudNavLink Href="/gestione-personale" Icon="@Icons.Material.Filled.CardTravel">Gestione Personale</MudNavLink>
    @* <MudNavLink Href="/notes" Icon="@Icons.Material.Filled.Map">Visualizza Mappa</MudNavLink> *@
    <MudNavLink Href="/elenco-soci" Icon="@Icons.Material.Filled.FolderShared">Elenco Soci</MudNavLink>
    <MudNavLink Href="/gestione-modelli" Icon="@Icons.Material.Filled.Notes">Gestione Modelli</MudNavLink>
    <MudNavLink Href="/disponibilita-mezzi" Icon="@Icons.Material.Filled.Alarm">Disponibilità Mezzi</MudNavLink>
</MudNavMenu>

@code {
    private DateTime CurrentDateTime = DateTime.Now;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            CurrentDateTime = DateTime.Now;
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}