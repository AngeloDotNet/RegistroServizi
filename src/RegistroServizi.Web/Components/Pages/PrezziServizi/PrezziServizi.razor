@page "/prezzi-servizi"
@rendermode InteractiveServer
@* @attribute [Authorize(Roles = nameof(Role.Manager))] *@
@inject IStringLocalizer<SharedResource> Localizer
@inject IOptions<MudBlazorDataGridOptions> DataGridOptions

<TextPageTitle Title="@Localizer["TitleServicePrices"]" SubTitle="@Localizer["SubTitleServicePrices"]" />

@*<PageTitle>@Localizer["ServicePrices"] · Registro Servizi</PageTitle>
<div class="section-header">
    <div>
        <h1 class="section-title">@Localizer["TitleServicePrices"]</h1>
        <p class="section-subtitle">@Localizer["SubTitleServicePrices"]</p>
    </div>
</div>*@

<MudPaper Class="pa-4 mb-4">
        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (elements.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Localizer["NoServicePricesFound"]</MudAlert>
        }
        else
        {
            <MudDataGrid T="PrezzoServizioDto"
                    Items="@elements"
                    SortMode="@DataGridOptions.Value.SortMode"
                    Bordered="@DataGridOptions.Value.Bordered"
                    Dense="@DataGridOptions.Value.Dense"
                    Hover="@DataGridOptions.Value.Hover">
                <ToolBarContent>
                    <MudSpacer />
                    <MudButtonGroup Class="ma-0 pa-0" Color="Color.Success" Variant="Variant.Filled">
                        <MudButton StartIcon="@Icons.Material.Filled.Add" @onclick="CreateItem" Variant="Variant.Filled" Color="Color.Primary">@Localizer["Add"]</MudButton>
                    </MudButtonGroup>
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="Id" Hidden="true" />
                    <PropertyColumn Property="x => x.TipologiaServizioId" Title="Tipologia Servizio Id" Hidden="true" />
                    <PropertyColumn Property="x => x.TipoServizio" Title="Tipo di Servizio" />
                    <PropertyColumn Property="x => x.CostoFisso" Title="Costo Fisso" Format="C2" />
                    <PropertyColumn Property="x => x.CostoKm" Title="Costo al Km" Format="C2" />
                    <PropertyColumn Property="x => x.SecondoTrasportato" Title="Secondo Trasportato" Format="C2" />
                    <PropertyColumn Property="x => x.FermoMacchina" Title="Fermo Macchina" Format="C2" />
                    <PropertyColumn Property="x => x.Accompagnatore" Title="Accompagnatore" Format="C2" />
                    <PropertyColumn Property="x => x.ScontoSocio" Title="Sconto Socio" Format="P2" />

                    @* <TemplateColumn Title="Tipo di Servizio">
                        <CellTemplate Context="context">
                            @context.Item.TipoServizio
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Costo Fisso">
                        <CellTemplate Context="context">
                            <div class="text-center w-100">
                                @($"{context.Item.CostoFisso:N2} €")
                            </div>
                        </CellTemplate>
                        <EditTemplate>
                            <MudNumericField T="decimal"
                                @bind-Value="context.Item.CostoFisso"
                                @bind-Value:after="() => ValidateCostoFisso(context.Item.CostoFisso)"
                                Label="Costo Fisso"
                                Variant="Variant.Outlined"
                                Step="0.1m"
                                Adornment="Adornment.End"
                                AdornmentText="€"
                                Format="N2"
                                Required="true"
                                RequiredError="Il costo fisso è obbligatorio."
                                Immediate="true" />
                        </EditTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Costo al Km">
                        <CellTemplate Context="context">
                            <div class="text-center w-100">
                                @($"{context.Item.CostoKm:N2} €")
                            </div>
                        </CellTemplate>
                        <EditTemplate>
                            <MudNumericField T="decimal"
                                @bind-Value="context.Item.CostoKm"
                                @bind-Value:after="() => ValidateCostoKm(context.Item.CostoKm)"
                                Label="Costo al Km"
                                Variant="Variant.Outlined"
                                Step="0.1m"
                                Adornment="Adornment.End"
                                AdornmentText="€"
                                Format="N2"
                                Required="true"
                                RequiredError="Il costo al km è obbligatorio."
                                Immediate="true" />
                        </EditTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Secondo Trasportato">
                        <CellTemplate Context="context">
                            <div class="text-center w-100">
                                @($"{context.Item.SecondoTrasportato:N2} €")
                            </div>
                        </CellTemplate>
                        <EditTemplate>
                            <MudNumericField T="decimal"
                                @bind-Value="context.Item.SecondoTrasportato"
                                @bind-Value:after="() => ValidateSecondoTrasportato(context.Item.SecondoTrasportato)"
                                Label="Secondo Trasportato"
                                Variant="Variant.Outlined"
                                Step="0.1m"
                                Adornment="Adornment.End"
                                AdornmentText="€"
                                Format="N2"
                                Required="true"
                                RequiredError="Il costo per il secondo trasportato è obbligatorio."
                                Immediate="true" />
                        </EditTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Fermo Macchina">
                        <CellTemplate Context="context">
                            <div class="text-center w-100">
                                @($"{context.Item.FermoMacchina:N2} €")
                            </div>
                        </CellTemplate>
                        <EditTemplate>
                            <MudNumericField T="decimal"
                                @bind-Value="context.Item.FermoMacchina"
                                @bind-Value:after="() => ValidateFermoMacchina(context.Item.FermoMacchina)"
                                Label="Fermo Macchina"
                                Variant="Variant.Outlined"
                                Step="0.1m"
                                Adornment="Adornment.End"
                                AdornmentText="€"
                                Format="N2"
                                Required="true"
                                RequiredError="Il costo per il fermo macchina è obbligatorio."
                                Immediate="true" />
                        </EditTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Accompagnatore">
                        <CellTemplate Context="context">
                            <div class="text-center w-100">
                                @($"{context.Item.Accompagnatore:N2} €")
                            </div>
                        </CellTemplate>
                        <EditTemplate>
                            <MudNumericField T="decimal?"
                                @bind-Value="context.Item.Accompagnatore"
                                @bind-Value:after="() => ValidateAccompagnatore(context.Item.Accompagnatore)"
                                Label="Accompagnatore"
                                Variant="Variant.Outlined"
                                Step="0.1m"
                                Immediate="true"
                                Adornment="Adornment.End"
                                AdornmentText="€"
                                Format="N2" />
                        </EditTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Sconto Socio">
                        <CellTemplate Context="context">
                            <div class="text-center w-100">
                                @(context.Item.ScontoSocio.HasValue ? $"{context.Item.ScontoSocio.Value:N0} %" : "-")
                            </div>
                        </CellTemplate>
                        <EditTemplate>
                            <MudNumericField T="int?"
                                @bind-Value="context.Item.ScontoSocio"
                                @bind-Value:after="() => ValidateScontoSocio(context.Item.ScontoSocio)"
                                Label="Sconto Socio"
                                Variant="Variant.Outlined"
                                Step="1"
                                Immediate="true"
                                Adornment="Adornment.End"
                                AdornmentText="%"
                                Format="N0" />
                        </EditTemplate>
                    </TemplateColumn> *@

                    @* <TemplateColumn CellClass="d-flex justify-end">
                        <CellTemplate>
                            @if (context.IsEditing)
                            {
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Check" Color="Color.Success" aria-label="Save changes" OnClick="@context.Actions.CommitEditingItemAsync" />
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" Color="Color.Error" aria-label="Cancel editing" OnClick="@context.Actions.CancelEditingItemAsync" />
                            }
                            else
                            {
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" Disabled="@isEditing" aria-label="Edit row" OnClick="@context.Actions.StartEditingItemAsync" />
                            }
                        </CellTemplate>
                    </TemplateColumn> *@

                    <TemplateColumn CellClass="d-flex justify-end">
                        <CellTemplate>
                            <MudStack Row Style="width: 250px" Justify="Justify.Center">
                                <MudButton Size="@Size.Small" StartIcon="@Icons.Material.Filled.Edit" Variant="@Variant.Filled" Color="@Color.Warning" @onclick="() => EditItem(context.Item)">@Localizer["Edit"]</MudButton>
                                @*<MudButton Size="@Size.Small" StartIcon="@Icons.Material.Filled.Delete" Variant="@Variant.Filled" Color="@Color.Error" Disabled="true">@Localizer["Delete"]</MudButton>*@
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    @if (elements.Count >= 10)
                    {
                        <DataGridPager TItem="PrezzoServizioDto"
                            DataGridOptions="@DataGridOptions.Value"
                            RowsPerPageString="Righe per pagina:"
                            InfoFormat="Righe {first_item} - {last_item} di {all_items}"
                            PageSizeSelector="true"
                            ShowNavigation="true"
                            ShowPageNumber="false" />
                    }
                </PagerContent>
            </MudDataGrid>
        }
</MudPaper>