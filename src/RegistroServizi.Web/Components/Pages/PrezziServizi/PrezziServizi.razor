@page "/prezzi-servizi"
@rendermode InteractiveServer
@inherits PageBaseHelper
@attribute [Authorize]

<TextPageTitle Title="@Localizer["TitleServicePrices"]" SubTitle="@Localizer["SubTitleServicePrices"]" />
@* <MudAlert Severity="Severity.Warning">Al momento non è possibile ne creare ne eliminare i prezzi dei servizi.</MudAlert> *@

<MudPaper Class="pa-4">
@if (isLoading || elements.Count == 0)
{
    <ProgressNoData IsLoading="@isLoading" ElementsCount="@elements.Count" CountMessage="@Localizer["NoServicePricesFound"]" />
}
else
{
    <DataGridGeneric T="PrezzoServizioDto"
                        Items="@elements"
                        ActionEditCallback="@((context) => EditItemAsync(Title, context.Id, context.TipoServizio))"
                        Columns="@columnDefinition"
                        LayoutWidths="@columnWidths"
                        DisableEditButton="@disableEditButton" />
}
</MudPaper>