{
    "Kestrel": {
        "Limits": {
            "MaxRequestBodySize": 5242880 // 5 MB
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Localization": {
        "DefaultCulture": "it-IT",
        "DefaultUICulture": "it"
    },
    "ConnectionStrings": {
        "SqlServerConnection": "Data Source=[HOSTNAME];Initial Catalog=RegistroServizi;User ID=[USERNAME];Password=[PASSWORD];Encrypt=False"
    },
    "Identity": {
        "RequireConfirmedAccount": false,
        "AllowedForNewUsers": true,
        "MaxFailedAccessAttempts": 5,
        "DefaultLockoutTimeSpan": "00:15:00",
        "Password": {
            "RequiredLength": 10
        }
    },
    "ApplicazioneOptions": {
        "NomeApplicazione": "Registro Servizi",
        "VersioneApplicazione": "1.0.0",
        "TimeZone": "Europe/Rome" // Time zone for the application
    },
    "AdminUserOptions": {
        "Username": "", // Username for the admin user
        "Email": "", // Email for the admin user
        "Password": "" // Password for the admin user
    },
    "AssociazioneOptions": {
        "NomeAssociazione": "Associazione di esempio",
        "SiglaAssociazione": "SOS"
    },
    "DataGridOptions": {
        "RowsPerPage": 10, // Default rows per page
        "PageSize": [ 10, 25, 50 ], // Options: 10, 25, 50
        "SortMode": "None", // Options: None, Single, Multiple
        "Bordered": true,
        "Dense": true,
        "Hover": true
    },
    "DataGridColumnWidths": {
        "Ospedali": [ "width: 30%", "width: 30%", "width: 30%", "width: 5%", "width: 5%" ],
        "PrezziServizi": [ "width: 22%", "width: 13%", "width: 13%", "width: 13%", "width: 13%", "width: 13%", "width: 13%" ],
        "Colonnine": [ "width: 33%", "width: 33%", "width: 33%" ]
    },
    "PermissionsTable": { // Options: Admin, Manager, Operator
        "Ospedali": {
            //"Add": [ "" ],
            //"Modify": [ "" ]
            //"Delete": [ "" ]
        },
        "PrezziServizi": {
            //"Add": [ "Manager" ],
            "Modify": [ "Admin", "Manager" ]
            //"Delete": [ "Admin" ]
        }
    }
}