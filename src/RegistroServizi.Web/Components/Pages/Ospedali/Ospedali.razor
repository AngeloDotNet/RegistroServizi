@page "/ospedali"
@rendermode InteractiveServer
@inherits PageBaseHelper

<TextPageTitle Title="@Localizer["TitleHospitals"]" SubTitle="@Localizer["SubTitleHospitals"]" />

<MudPaper Class="pa-4 mb-4">
@if (isLoading || elements.Count == 0)
{
    <ProgressNoData IsLoading="@isLoading" ElementsCount="@elements.Count" CountMessage="@Localizer["NoHospitalsFound"]" />
}
else
{
    <DataGridGeneric T="OspedaleDto"
                        Items="@elements"
                        ActionCallback="@(() => CreateItemAsync(Title))"
                        ActionEditCallback="@((context) => EditItemAsync(Title, context.Id, context.NomeOspedale))"
                        ActionDeleteCallback="@((context) => DeleteItemAsync(Title, context.Id, context.NomeOspedale))"
                        Columns="@columnDefinition"
                        LayoutWidths="@columnWidths" />
}
</MudPaper>