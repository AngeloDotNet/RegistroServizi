@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IOptionsMonitor<ApplicazioneOptions> ApplicazioneOptions
@inject IOptionsMonitor<AssociazioneOptions> AssociazioneOptions
@inject IStringLocalizer<SharedResource> Localizer
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Nascondi menu" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">@_nomeAssociazione</MudText>
        <MudSpacer />
        
        <AuthorizeView Context="auth">
            <Authorized>
                <MudAvatar Variant="Variant.Outlined" Class="user-avatar">@GetProfileInitials(auth.User.Identity?.Name)</MudAvatar>
                <MudText class="user-profile d-none d-sm-flex">@auth.User.Identity?.Name</MudText>
                <form action="Account/Logout" method="post" style="margin:0">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" Class="btn-logout" title="Log out" StartIcon="@Icons.Material.Filled.Logout">
                        <span class="d-none d-sm-inline">Log out</span>
                    </MudButton>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/Account/Login" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login" Variant="Variant.Text">Log in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/AngeloDotNet/RegistroServizi" Target="_blank" />
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Class="drawer">
        <NavigationMenu />
    </MudDrawer>

    @* <MudMainContent Style="min-height: calc(100vh - 120px);"> *@
    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
    <Footer />
</MudLayout>