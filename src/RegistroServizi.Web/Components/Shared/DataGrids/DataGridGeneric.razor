@typeparam T
@inject IStringLocalizer<SharedResource> Localizer
@inject IOptions<MudDataGridOptions> DataGridOptions
@inject DataGridHelper DataGridHelper

<MudDataGrid T="@T"
                Items="@Items"
                SortMode="@DataGridOptions.Value.SortMode"
                Bordered="@DataGridOptions.Value.Bordered"
                Dense="@DataGridOptions.Value.Dense"
                Hover="@DataGridOptions.Value.Hover"
                RowsPerPage="@DataGridOptions.Value.RowsPerPage">

    <ToolBarContent>
        <MudSpacer />
        @if (ActionCallback.HasDelegate)
        {
            <MudButtonGroup Class="ma-0 pa-0" Color="Color.Success" Variant="Variant.Filled">
                @* <MudButton StartIcon="@Icons.Material.Filled.Add"
                            @onclick="ActionCallback"
                            Variant="Variant.Filled"
                            Disabled="@DisableAddButton"
                            Color="@Color.Success">@Localizer["Add"]</MudButton> *@
                <MudFab @onclick="ActionCallback" Size="Size.Small" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Disabled="@DisableAddButton" />
            </MudButtonGroup>
        }
    </ToolBarContent>

    <ColGroup>
        @foreach (var width in LayoutWidths)
        {
            <col style="@width" />
        }
    </ColGroup>

    <Columns>
        @foreach (var colDef in Columns)
        {
            @if (!string.IsNullOrEmpty(colDef.Format))
            {
                <PropertyColumn Property="@colDef.Property" Title="@colDef.Title" Hidden="colDef.IsHidden" Format="@colDef.Format" />
            }
            else
            {
                <PropertyColumn Property="@colDef.Property" Title="@colDef.Title" Hidden="colDef.IsHidden" />
            }
        }

        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudStack Row Style="width: 250px" Justify="Justify.Center">
                    @if (ActionEditCallback.HasDelegate)
                    {
                        @* <MudButton StartIcon="@MudblazorPresets.IconEdit"
                                    @onclick="() => ActionEditCallback.InvokeAsync(context.Item)"
                                    Variant="Variant.Filled"
                                    Disabled="@DisableEditButton"
                                    Color="@Color.Warning">@Localizer["Edit"]</MudButton> *@
                        <MudFab @onclick="() => ActionEditCallback.InvokeAsync(context.Item)" Size="Size.Small" Color="Color.Warning" StartIcon="@MudblazorPresets.IconEdit" Disabled="@DisableEditButton" />
                    }

                    @if (ActionDeleteCallback.HasDelegate)
                    {
                        @* <MudButton StartIcon="@MudblazorPresets.IconDelete"
                                    @onclick="() => ActionDeleteCallback.InvokeAsync(context.Item)"
                                    Variant="Variant.Filled"
                                    Disabled="@DisableDeleteButton"
                                    Color="@Color.Error">@Localizer["Delete"]</MudButton> *@
                        <MudFab @onclick="() => ActionDeleteCallback.InvokeAsync(context.Item)" Size="Size.Small" Color="Color.Error" StartIcon="@MudblazorPresets.IconDelete" Disabled="@DisableDeleteButton" />
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="@T"
                            PageSizeOptions="@DataGridOptions.Value.PageSize"
                            PageSizeSelector="true"
                            ShowNavigation="true"
                            ShowPageNumber="true"
                            RowsPerPageString="@DataGridHelper.RowsPerPageString"
                            InfoFormat="@DataGridHelper.RowsPerPageInfoFormat" />
    </PagerContent>
</MudDataGrid>