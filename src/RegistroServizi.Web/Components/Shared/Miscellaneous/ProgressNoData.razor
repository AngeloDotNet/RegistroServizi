@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (ElementsCount == 0)
{
    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">@CountMessage</MudAlert>
}

