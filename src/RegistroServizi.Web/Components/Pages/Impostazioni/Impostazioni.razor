@page "/impostazioni"
@rendermode InteractiveServer
@inject NavigationManager navigationManager

<PageTitle>Impostazioni · Registro Servizi</PageTitle>

<div class="section-header">
    <div>
        <h1 class="section-title">Impostazioni</h1>
        <p class="section-subtitle">Gestione delle impostazioni dell'applicazione</p>
    </div>
</div>

<div class="mudpaper-grid mb-4">
    <MudPaper Elevation="2" Class="mudpaper pa-4" @onclick="() => ViewPrezziServizi()">
        <div class="d-flex gap-3">
            <div class="mudpaper-icon prezziservizi"><MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="MudBlazor.Size.Medium" /></div>
            <div class="flex-grow-1" style="min-width: 0;">
                <div class="d-flex justify-space-between align-start mb-2">
                    <div class="flex-grow-1" style="min-width: 0;">
                        <div style="font-weight: 600; font-size: 1.1rem; color: var(--mb-text-primary); margin-bottom: 6px;">Prezzi Servizi</div>
                        <div style="font-size: 0.75rem; color: var(--mb-text-muted);">Gestione dei prezzi di ogni singolo servizio</div>
                    </div>
                </div>
            </div>
        </div>
    </MudPaper>
</div>

@code {
    /// <summary>
    /// Navigates to the Prezzi Servizi page.
    /// </summary>
    private void ViewPrezziServizi() => navigationManager.NavigateTo("/prezzi-servizi");
}